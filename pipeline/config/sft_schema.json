{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SFT Sample",
  "description": "Schema for Tibetan SFT training data (§5.1.4 canonical format)",
  "type": "object",
  "required": ["id", "messages", "metadata"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^bo_sft_\\d{6}$"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["system", "user", "assistant"] },
          "content": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      },
      "minItems": 2
    },
    "metadata": {
      "type": "object",
      "required": [
        "L1_domain", "L2_task_type", "L3_task", "task_code",
        "language", "difficulty", "turns", "has_system",
        "source", "method", "created_at", "version"
      ],
      "properties": {
        "L1_domain": { "type": "string" },
        "L2_task_type": { "type": "string" },
        "L3_task": { "type": "string" },
        "task_code": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "language": {
          "type": "object",
          "required": ["input", "output"],
          "properties": {
            "input": { "enum": ["tibetan", "chinese", "english", "bilingual"] },
            "output": { "enum": ["tibetan", "chinese", "english", "bilingual"] }
          },
          "additionalProperties": false
        },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "turns": { "type": "integer", "minimum": 1 },
        "has_system": { "type": "boolean" },
        "source": { "enum": ["synthetic", "human", "translated", "augmented"] },
        "method": { "enum": ["M1", "M2", "M3", "M4", "M5", "M6", "M7"] },
        "generator_model": { "type": "string" },
        "quality_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "quality_tier": { "enum": ["gold", "silver", "bronze", null] },
        "dialect": { "enum": ["standard", "amdo", "kham", "uke"] },
        "script": { "enum": ["tibetan", "wylie", "mixed"] },
        "domain_tags": { "type": "array", "items": { "type": "string" } },
        "requires_cultural_knowledge": { "type": "boolean" },
        "created_at": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
